            <div class="dim mono" style="font-size:12px;">POST https://api.acme.io/hooks/authkit</div>
          </div>
          <div class="row">
            <button class="btn btn-secondary"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg> Send test event</button>
            <button class="btn btn-secondary"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 1 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg> Edit</button>
            <button class="btn btn-danger" data-confirm="Delete endpoint?"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6h14z"/><path d="M10 11v6M14 11v6"/></svg></button>
          </div>
        </div>

        <div class="stats-grid" style="grid-template-columns:repeat(4,1fr);">
          <div class="stat">
            <div class="between">
              <div class="stat-label">Deliveries (24h)</div>
              <div class="stat-icon"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg></div>
            </div>
            <div class="stat-value">1,240</div>
            <div class="stat-meta up"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m23 6-9.5 9.5-5-5L1 18"/><path d="M17 6h6v6"/></svg> <span>+6%</span> <span class="dim">vs last week</span></div>
          </div>
          
          <div class="stat">
            <div class="between">
              <div class="stat-label">Success rate</div>
              <div class="stat-icon"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m22 4-10 10-3-3"/></svg></div>
            </div>
            <div class="stat-value">99.7%</div>
            <div class="stat-meta up"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m23 6-9.5 9.5-5-5L1 18"/><path d="M17 6h6v6"/></svg> <span>+0.1%</span> <span class="dim">vs last week</span></div>
          </div>

          <div class="stat">
            <div class="between">
              <div class="stat-label">Avg latency</div>
              <div class="stat-icon"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg></div>
            </div>
            <div class="stat-value">142ms</div>
            <div class="stat-meta up"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m23 6-9.5 9.5-5-5L1 18"/><path d="M17 6h6v6"/></svg> <span>-8ms</span> <span class="dim">vs last week</span></div>
          </div>
          
          <div class="stat">
            <div class="between">
              <div class="stat-label">Retries</div>
              <div class="stat-icon"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg></div>
            </div>
            <div class="stat-value">3</div>
            <div class="stat-meta up"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m23 6-9.5 9.5-5-5L1 18"/><path d="M17 6h6v6"/></svg> <span>-2</span> <span class="dim">vs last week</span></div>
          </div>
        </div>

        <div class="two-col">
          <div class="card">
            <div class="card-header"><h3>Recent deliveries</h3><a href="#" class="text-primary" style="font-size:12px;">View all</a></div>
            <table class="table">
              <thead><tr><th>Event</th><th>Type</th><th>Status</th><th>Latency</th><th>When</th><th></th></tr></thead>
              <tbody>
                <tr>
                  <td class="mono">evt_a1</td>
                  <td>user.created</td>
                  <td><span class="badge badge-success">200</span></td>
                  <td>142ms</td>
                  <td class="dim">3m ago</td>
                  <td class="row-actions"><button class="btn btn-ghost btn-sm">Replay</button></td>
                </tr>
                <tr>
                  <td class="mono">evt_a2</td>
                  <td>session.created</td>
                  <td><span class="badge badge-success">200</span></td>
                  <td>121ms</td>
                  <td class="dim">6m ago</td>
                  <td class="row-actions"><button class="btn btn-ghost btn-sm">Replay</button></td>
                </tr>
                <tr>
                  <td class="mono">evt_a3</td>
                  <td>mfa.enrolled</td>
                  <td><span class="badge badge-success">200</span></td>
                  <td>98ms</td>
                  <td class="dim">12m ago</td>
                  <td class="row-actions"><button class="btn btn-ghost btn-sm">Replay</button></td>
                </tr>
                <tr>
                  <td class="mono">evt_a4</td>
                  <td>user.updated</td>
                  <td><span class="badge badge-danger">429</span></td>
                  <td>34ms</td>
                  <td class="dim">18m ago</td>
                  <td class="row-actions"><button class="btn btn-ghost btn-sm">Replay</button></td>
                </tr>

                <tr>
                  <td class="mono">evt_a5</td>
                  <td>session.revoked</td>
                  <td><span class="badge badge-success">200</span></td>
                  <td>156ms</td>
                  <td class="dim">24m ago</td>
                  <td class="row-actions"><button class="btn btn-ghost btn-sm">Replay</button></td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="card">
            <div class="card-header"><h3>Signing secret</h3></div>
            <div class="card-body stack" style="--gap:14px;">
              <div class="code">
                <button class="copy-btn" data-copy="whsec_9f2a4b8c7e1d3f5g6h"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> Copy</button>
                <pre>whsec_9f2a4b8c7e1d3f5g6h</pre>
              </div>
              
              <div class="dim" style="font-size:12px;">Verify signatures with HMAC SHA-256 on the <code>Authkit-Signature</code> header.</div>
              <button class="btn btn-secondary" data-confirm="Rotate signing secret?">Rotate secret</button>
            </div>
          </div>

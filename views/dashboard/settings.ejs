      <main class="page">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/app/overview.html">Dashboard</a><span class="sep">/</span><span class="current">Settings</span></nav>
        
        <div class="page-head">
          <div>
            <h1>Settings</h1>
            <p>Project configuration, API keys, and preferences.</p>
          </div>
          <div class="page-actions"></div>
        </div>

        <div class="tabs" data-tabs-group="s">
          <button class="active" data-tab="s-general" data-group="s">General</button>
          <button data-tab="s-api" data-group="s">API keys</button>
          <!-- <button data-tab="s-team" data-group="s">Team</button> -->
          <button data-tab="s-billing" data-group="s">Billing</button>
          <button data-tab="s-security" data-group="s">Security</button>
        </div>

        <div class="two-col active-tab" data-tabs-body="s-general">
          <div class="stack" style="--gap:20px;">

            <div class="card">
              <div class="card-header"><h3>Profile Settings</h3></div>
              <div class="card-body stack multi-col" style="--gap:14px;">
                <div class="field"><label>Project name</label><input class="input" value="<%=developer.appName%>" /></div>
                <div class="field"><label>Project ID</label><input disabled class="input mono" value="<%=developer.id%>" readonly /></div>
                <div class="field"><label>Project URL</label><input class="input" value="https://acme.io/login" /></div>
                <div class="field"><label>Email Address</label><input class="input" value="<%=developer.email%>" /></div>
                <div class="field"><label>Full Name</label><input class="input" value="https://acme.io/login" /></div>
                <div class="field"><label>Join Date</label><input disabled class="input" value="<%=developer.createdAt.toLocaleDateString()%>" /></div>
              </div>
              <div class="card-footer between"><span class="dim" style="font-size:12px;">Changes save automatically</span><button class="btn btn-primary btn-sm">Update profile</button></div>
            </div>

            <div class="card">
              <div class="card-header"><h3>Danger zone</h3></div>
              <div class="card-body stack" style="--gap:14px;">
                <div class="between"><div><strong style="font-size:13px;">Transfer project</strong><div class="dim" style="font-size:12px;">Move ownership to another user.</div></div><button class="btn btn-secondary btn-sm">Transfer</button></div>
                <hr class="divider" />
                <div class="between"><div><strong style="font-size:13px;color:var(--danger);">Delete project</strong><div class="dim" style="font-size:12px;">Permanently delete this project and all data.</div></div><button class="btn btn-danger btn-sm" data-confirm="This action is irreversible. Continue?">Delete</button></div>
              </div>
            </div>
          </div>

          <div class="stack" style="--gap:20px;">
            <div class="card">
              <div class="card-header"><h3>Environment</h3></div>
              <div class="card-body stack" style="--gap:10px;">
                <div class="between"><span>Environment</span><span class="badge badge-primary">Production</span></div>
                <div class="between"><span>Region</span><span>us-east-1</span></div>
                <div class="between"><span>Version</span><span class="mono">v2026.08.12</span></div>
              </div>
            </div>
            <div class="card">
              <div class="card-header"><h3>Preferences</h3></div>
              <div class="card-body stack" style="--gap:10px;">
                <div class="between"><span>Email alerts</span><div class="switch on"></div></div>
                <div class="between"><span>Weekly digest</span><div class="switch on"></div></div>
                <div class="between"><span>Product updates</span><div class="switch"></div></div>
              </div>
            </div>
          </div>
        </div>

        <div class="close-tab" data-tabs-body="s-api">
          <div class="stack" style="--gap:20px;">
            <div class="card" id="api-keys">
              <div class="card-header">
                <h3>API keys</h3>
                <button class="btn btn-primary">
                  <svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 5v14M5 12h14"/>
                  </svg>New API Key
                </button>
              </div>
              <div class="card-body" style="padding:0;">
                <table class="table">
                  <thead>
                    <tr>
                      <th>Name</th>
                      <th>Key</th>
                      <th>Scope</th>
                      <th>Last used</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td>Production</td>
                      <td class="key-row">
                        <span class="masked"><%=developer.apiKey.slice(0, 5) + ".........." + developer.apiKey.slice(-5)%></span> 
                        <button class="btn btn-ghost btn-icon" data-copy="<%=developer.apiKey%>">
                          <svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                          </svg>
                        </button>
                      </td>
                      <td>
                        <span class="badge">Full access</span></td>
                        <td class="dim">2m ago</td>
                        <td class="row-actions">
                          <button class="btn btn-ghost btn-icon" data-modal-open="invite-modal">
                            <svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                              <path d="M18.5 2.5a2.12 2.12 0 1 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                            </svg>
                          </button>
                        </td>
                      </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>


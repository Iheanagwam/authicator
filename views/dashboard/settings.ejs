<script src="/assets/js/app.js"></script>
<script>
  document.addEventListener("click", async (e) =>{
    const t = e.target.closest("[data-action]");
    if(!t) return;
    
    const dataKey = t.getAttribute("data-key") || "";
    if(dataKey !== e.target.id) return;

    try{
      const alertMoal = document.querySelector("#info-modal");
      const alertBox = document.querySelector("#alertBox");
      const alertHead = document.querySelector("#alertHead");

      const baseUrl = "http://localhost:5000";
      const endPoint = `dashboard/${dataKey}`;
      const getOption = {
        method: "get",
        Headers: {"Content-Type": "application/json"}
      };

      const res = await fetch(`${baseUrl}/${endPoint}`, getOption);
      const data = await res.json();
      if(data.status === 200){
        alertMoal.classList.add("open");
        alertHead.textContent = "Success Alert";
        alertBox.textContent = data.message + data.developer.apiKey;
      }else{
        alertMoal.classList.add("open");
        alertHead.textContent = "Failure Alert";
        alertBox.textContent = data.message;
      };
    }catch(err){
      console.log(err);
    };
  });
</script>

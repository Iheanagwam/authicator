<body>

  <div class="app">
    
    <!-- ============ SIDEBAR (EJS partial: layouts/sidebar) ============ -->
    <aside class="sidebar">
      <%- include('partials/sidebar') %>
    </aside>

    <div class="main">
      
      <!-- ============ TOPBAR (EJS partial: layouts/topbar) ============ -->

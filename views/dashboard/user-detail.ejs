<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>User detail — AuthKit</title>
<meta name="description" content="AuthKit — drop-in authentication, users, and access control for modern apps." />
<link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/assets/css/base.css" />
<link rel="stylesheet" href="/assets/css/components.css" />
<link rel="stylesheet" href="/assets/css/layout.css" />
<link rel="stylesheet" href="/assets/css/pages.css" />

</head>
<body>

  <div class="app">
    
    <!-- ============ SIDEBAR (EJS partial: layouts/sidebar) ============ -->
    <aside class="sidebar">
      <%- include('partials/sidebar') %>
    </aside>

    <div class="main">
      
      <!-- ============ TOPBAR (EJS partial: layouts/topbar) ============ -->
      <header class="topbar">
        <%- include('partials/header') %>
      </header>
        
      <main class="page">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/app/overview.html">Dashboard</a><span class="sep">/</span><a href="/app/users.html">Users</a><span class="sep">/</span><span class="current">Sofia Alvarez</span></nav>
        <div class="detail-head">
          <div class="avatar-lg">SA</div>

          <div class="grow">
            <div class="row" style="gap:10px;">
              <h1 style="font-size:22px;">
                <%if(user.metadata === null){%>
                  Sofia Alvarez
                <%}else{%>
                  <%if(!user.metadata.full_name){%>
                    <%=user.metadata.first_name%> <%=user.metadata.last_name%>
                  <%}else{%>
                    <%=user.metadata.full_name%>
                  <%}%>
                <%}%>
              </h1>
              <span class="badge badge-success badge-dot">Active</span>
            </div>
            <div class="dim" style="font-size:13px;"><%=user.email%> · Joined <%=user.createdAt.toLocaleDateString("en-US", {month: "short", day: "numeric", year: "numeric"})%></div>
          </div>
          
          <div class="row">
            <button class="btn btn-secondary"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg> Message</button>
            <button class="btn btn-danger" data-confirm="Suspend this user?">Suspend</button>
          </div>
        </div>

        <div class="tabs" data-tabs-group="user">
          <button class="active" data-tab="u-overview" data-group="user">Overview</button>
          <button data-tab="u-sessions" data-group="user">Sessions</button>
          <button data-tab="u-security" data-group="user">Security</button>
          <button data-tab="u-events" data-group="user">Events</button>
        </div>

        <div class="two-col">
          <div class="stack" style="--gap:20px;">
            <div class="card">
              <div class="card-header"><h3>Profile</h3><button class="btn btn-ghost btn-sm"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 1 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg> Edit</button></div>
              <div class="card-body">
                <div class="grid" style="grid-template-columns:1fr 1fr;--gap:16px;">
                  <div>
                    <div class="dim" style="font-size:11px;text-transform:uppercase;letter-spacing:0.08em;">Email</div>
                    <div><%=user.email%></div>
                  </div>
                  
                  <div>
                    <div class="dim" style="font-size:11px;text-transform:uppercase;letter-spacing:0.08em;">User ID</div>
                    <div class="mono" style="font-size:12px;"><%=user.id%></div>
                  </div>
                  
                  <div>
                    <div class="dim" style="font-size:11px;text-transform:uppercase;letter-spacing:0.08em;">Full name</div>
                    <div>
                      <%if(user.metadata === null){%>
                        Sofia Alvarez
                      <%}else{%>
                        <%if(!user.metadata.full_name){%>
                          <%=user.metadata.first_name%> <%=user.metadata.last_name%>
                        <%}else{%>
                          <%=user.metadata.full_name%>
                        <%}%>
                      <%}%>
                    </div>
                  </div>

                  <div>
                    <div class="dim" style="font-size:11px;text-transform:uppercase;letter-spacing:0.08em;">Country</div>
                    <div>
                      <%if(user.metadata === null){%>
                        No country
                      <%}else{%>
                        <%if(!user.metadata.country){%>
                          No country
                        <%}else{%>
                          <%=user.metadata.country%>
                        <%}%>
                      <%}%>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="card">
              <div class="card-header"><h3>Active sessions</h3></div>
              <div class="card-body" style="padding:0;">
                <table class="table">
                  <thead><tr><th>Device</th><th>IP</th><th>Location</th><th>Started</th><th></th></tr></thead>
                  <tbody>
                    <tr><td>MacBook Pro · Chrome 128</td><td class="mono">92.14.201.7</td><td>Barcelona, ES</td><td class="dim">2 min ago</td><td class="row-actions"><button class="btn btn-ghost btn-sm">Revoke</button></td></tr>
                    <tr><td>iPhone · Safari</td><td class="mono">92.14.201.7</td><td>Barcelona, ES</td><td class="dim">4h ago</td><td class="row-actions"><button class="btn btn-ghost btn-sm">Revoke</button></td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <div class="stack" style="--gap:20px;">
            <div class="card">
              <div class="card-header"><h3>Security</h3></div>
              <div class="card-body stack" style="--gap:14px;">
                <div class="between"><div><strong style="font-size:13px;">Multi-factor auth</strong><div class="dim" style="font-size:12px;">TOTP + WebAuthn</div></div><span class="badge badge-success">Enabled</span></div>
                <hr class="divider" />
                <div class="between"><div><strong style="font-size:13px;">Passkey</strong><div class="dim" style="font-size:12px;">Registered Aug 4</div></div><span class="badge badge-success">Active</span></div>
                <hr class="divider" />
                <div class="between"><div><strong style="font-size:13px;">Password</strong><div class="dim" style="font-size:12px;">Set 43 days ago</div></div><button class="btn btn-ghost btn-sm">Force reset</button></div>
              </div>
            </div>
            
            <div class="card">
              <div class="card-header"><h3>Recent events</h3></div>
              <div class="card-body">
                <div class="feed">
                  <div class="feed-item"><div class="fdot"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div><div class="fbody">Signed in from Barcelona<div class="ftime">2 min ago</div></div></div>
                  <div class="feed-item"><div class="fdot"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 2l-9.6 9.6"/><circle cx="7.5" cy="15.5" r="5.5"/><path d="m21 2-2 2"/><path d="m18 5 3 3"/></svg></div><div class="fbody">MFA challenge passed<div class="ftime">2 min ago</div></div></div>
                  <div class="feed-item"><div class="fdot"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 1 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></div><div class="fbody">Updated profile name<div class="ftime">yesterday</div></div></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

<script src="/assets/js/app.js"></script>
</body>
</html>

<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Webhooks — AuthKit</title>
<meta name="description" content="AuthKit — drop-in authentication, users, and access control for modern apps." />
<link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/assets/css/base.css" />
<link rel="stylesheet" href="/assets/css/components.css" />
<link rel="stylesheet" href="/assets/css/layout.css" />
<link rel="stylesheet" href="/assets/css/pages.css" />
</head>
<body>
  <div class="app">   
    <!-- ============ SIDEBAR (EJS partial: layouts/sidebar) ============ -->
    <aside class="sidebar">
      <%- include('partials/sidebar') %>
    </aside>

    <div class="main">
      <!-- ============ TOPBAR (EJS partial: layouts/topbar) ============ -->
      <header class="topbar">
        <%- include('partials/header') %>
      </header>

      <main class="page">
        <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/app/overview.html">Dashboard</a><span class="sep">/</span><span class="current">Webhooks</span></nav>
        
        <div class="page-head">
          <div>
            <h1>Webhooks</h1>
            <p>Push signed, retryable events to your services in real time.</p>
          </div>
          <div class="page-actions">
            <button class="btn btn-secondary">
              <svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/>
              </svg> Events reference
            </button>
            <a class="btn btn-primary" data-modal-open="invite-modal">
              <svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/>
              </svg>Create webhook
            </a>
          </div>
        </div>

        <div class="stats-grid" style="grid-template-columns:repeat(3,1fr);">
          <div class="stat">
            <div class="between">
              <div class="stat-label">Endpoints</div>
              <div class="stat-icon"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 16.98h-5.99c-1.1 0-1.95.94-2.48 1.9A4 4 0 0 1 2 17c.01-.7.2-1.4.57-2"/><path d="m6 17 3.13-5.78c.53-.97.1-2.18-.5-3.1a4 4 0 1 1 6.89-4.06"/><path d="m12 6 3.13 5.73C15.66 12.7 16.9 13 18 13a4 4 0 0 1 0 8"/></svg></div>
            </div>
            <div class="stat-value"><%=count%></div>
            <div class="stat-meta up"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m23 6-9.5 9.5-5-5L1 18"/><path d="M17 6h6v6"/></svg> <span>+1 this week</span> <span class="dim">vs last week</span></div>
          </div>

          <div class="stat">
            <div class="between">
              <div class="stat-label">Events / day</div>
              <div class="stat-icon"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg></div>
            </div>
            <div class="stat-value">12,481</div>
            <div class="stat-meta up"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m23 6-9.5 9.5-5-5L1 18"/><path d="M17 6h6v6"/></svg> <span>+8.4%</span> <span class="dim">vs last week</span></div>
          </div>

          <div class="stat">
            <div class="between">
              <div class="stat-label">Delivery rate</div>
              <div class="stat-icon"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m22 4-10 10-3-3"/></svg></div>
            </div>
            <div class="stat-value">98.6%</div>
            <div class="stat-meta down"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m23 18-9.5-9.5-5 5L1 6"/><path d="M17 18h6v-6"/></svg> <span>-0.3%</span> <span class="dim">vs last week</span></div>
          </div>
        </div>

        <div class="two-col" style="margin-bottom:20px;">
          <div class="card">
            <div class="card-header"><h3>Delivery volume</h3></div>
            <div class="card-body" style="height:260px;"><canvas id="chart-webhooks"></canvas></div>
          </div>
          
          <div class="card">
            <div class="card-header"><h3>Health</h3></div>
            <div class="card-body stack" style="--gap:12px;">
              <div class="between"><span>Success rate</span><strong class="text-success">98.6%</strong></div>
              <div class="between"><span>Retries in queue</span><strong>14</strong></div>
              <div class="between"><span>Median latency</span><strong>142ms</strong></div>
              <div class="between"><span>p95 latency</span><strong>612ms</strong></div>
              <div class="alert alert-warning"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4M12 17h.01"/><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/></svg><div>1 endpoint below 90% success. <a href="#" style="color:inherit;text-decoration:underline;">Review</a></div></div>
            </div>
          </div>
        </div>

        <div class="table-wrap">
          <div class="table-toolbar">
            <div class="input-icon" style="flex:1;max-width:320px;"><svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg><input class="input" placeholder="Search endpoints..." /></div>
            <button class="btn btn-secondary btn-sm"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/></svg> Status</button>
          </div>

          <table class="table">
            <thead>
              <tr>
                <th>Endpoint</th>
                <th>Events</th>
                <th>Status</th>
                <th>Delivery</th>
                <th>Health</th>
                <th></th>
              </tr>
            </thead>
            <!-- webhooks.forEach(hook => …) -->
            <tbody>
              <%webhooks.forEach((webhook) =>{%>
                <tr>
                  <td>
                    <a href="/dashboard/webhook-detail" class="mono" style="color:var(--text);font-weight:500;">User event webhook</a>
                    <div class="dim mono" style="font-size:11px;"><%=webhook.url%></div>
                  </td>
                  <td><span class="badge" style="word-wrap: break-word; word-break: break-all;"><%=webhook.events.join(", ")%></span></td>
                  <td><span class="badge badge-success badge-dot"><%=webhook.isActive%></span></td>
                  <td>99.7%</td>
                  <td><span class="badge badge-success badge-dot">Success</span></td>
                  <td class="row-actions">
                    <button class="btn btn-ghost btn-icon">
                      <svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                        <path d="M18.5 2.5a2.12 2.12 0 1 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                      </svg>
                    </button>
                    <button class="btn btn-ghost btn-icon" data-confirm="Delete webhook?">
                      <svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6h14z"/><path d="M10 11v6M14 11v6"/>
                      </svg>
                    </button>
                  </td>
                </tr>
              <%})%>
            </tbody>
          </table>
        </div>

        <!-- ============ Invite modal ============ -->
        <div class="modal-backdrop" id="invite-modal">
          <form action="/dashboard/createWebhooks" method="post">
            <div class="modal">
              <div class="modal-header"><h3>Create webhook for real-time update</h3></div>
              <div class="modal-body">
                <div class="stack" style="--gap:14px;">
                  <div class="field">
                    <label>Webhook URL</label>
                    <input class="input" type="text" name="url" placeholder="https://www.platform-domain.com" />
                  </div>
                  <h4>Select Events</h4>
                  <label class="checkbox">
                    <input name="events" value="user.login" type="checkbox" checked /> User sign in
                  </label>
                  <label class="checkbox">
                    <input name="events" value="user.registered" type="checkbox" /> New user registration
                  </label>
                  <label class="checkbox">
                    <input name="events" value="user.verified" type="checkbox" /> User get verified
                  </label>
                  <label class="checkbox">
                    <input name="events" value="user.deleted" type="checkbox" /> User deletes account
                  </label>
                  <label class="checkbox">
                    <input name="events" value="user.logout" type="checkbox" /> User sign out
                  </label>
                  <label class="checkbox">
                    <input name="events" value="user.password_changed" type="checkbox" /> User resets password
                  </label>
                  <label class="checkbox">
                    <input name="events" value="user.updated" type="checkbox" /> User updates profile
                  </label>
                </div>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-ghost" data-modal-close>Cancel</button>
                <button class="btn btn-primary" data-modal-close>Create</button>
              </div>
            </div>
          </form>
        </div>
      </main>
    </div>
  </div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script src="/assets/js/app.js"></script>
<script src="/assets/js/charts.js"></script>
</body>
</html>

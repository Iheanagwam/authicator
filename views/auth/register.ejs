<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Get started — AuthKit</title>
<meta name="description" content="AuthKit — drop-in authentication, users, and access control for modern apps." />
<link rel="icon" href="/assets/images/favicon.svg" type="image/svg+xml" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/assets/css/base.css" />
<link rel="stylesheet" href="/assets/css/components.css" />
<link rel="stylesheet" href="/assets/css/layout.css" />
<link rel="stylesheet" href="/assets/css/pages.css" />

</head>
<body>

<div class="auth-shell">
  <div class="auth-form-panel" style="position:relative;">
    <a href="/" class="brand">
      <span class="logo">A</span>
      <span>AuthKit</span>
    </a>
    <form class="auth-form" onsubmit="AuthKit.toast('Creating account…');"
      method="POST" action="/register" style="margin-top: 1rem;">
      <div>
        <h1>Create your workspace</h1>
        <p class="subtitle">Start free — no credit card required.</p>
      </div>

      <div class="field">
        <label>Project Name</label>
        <input class="input" name="appName" placeholder="My App" required />
      </div>

      <div class="field">
        <label>Work email</label>
        <div class="input-icon">
          <svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m22 6-10 7L2 6"/>
          </svg>
          <input class="input" type="email" name="email" placeholder="you@company.com" required />
        </div>
      </div>

      <div class="field">
        <label>Password</label>
        <div class="input-group">
          <input class="input" type="password" name="password" placeholder="Choose a strong password" required data-pw-strength="#pw-meter" />
          <button type="button" class="input-affix" data-pw-toggle>
            <svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
          </button>
        </div>
        <div class="strength" id="pw-meter" data-score="0"><span></span><span></span><span></span><span></span></div>
        <div class="hint">At least 8 characters, mixed case, and one number.</div>
      </div>
      
      <div class="field">
        <label>Confirm Password</label>
        <div class="input-group">
          <input class="input" type="password" name="confirmPassword" placeholder="Confirm your password" required data-pw-match="pw-match" id="pw-match"/>
          <button type="button" class="input-affix" data-pw-toggle>
            <svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
          </button>
        </div>
      </div>

      <label class="checkbox"><input type="checkbox" required /> I agree to the <a href="#" class="text-primary">Terms</a> and <a href="#" class="text-primary">Privacy Policy</a>.</label>

      <button class="btn btn-primary btn-lg btn-block" type="submit">Create workspace <svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></button>
      <div class="foot">Already have an account? <a href="/login">Sign in</a></div>

      <div class="divider-text">or join with</div>
      <div class="social">
        <button disabled type="button" class="btn btn-secondary"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg> Google</button>
        <button disabled type="button" class="btn btn-secondary"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/></svg> GitHub</button>
      </div>
    </form>
  </div>

  <div class="auth-side">
    <div class="auth-side-content">
      <span class="badge badge-primary badge-dot">Live</span>
      <h2>Ship auth in minutes, not months.</h2>
      <p>Join 12,000+ developer teams building on AuthKit. Free forever for the first 5,000 users — every feature, no paywalls.</p>
      
    </div>
  </div>
</div>

<script src="/assets/js/app.js"></script>
<script>
   /* --- Password match --- */
  document.querySelector("#pw-match").addEventListener("input", (e) => {
    const cp = e.target.closest("[data-pw-match]");
    const p = document.querySelector("[data-pw-strength]");

    if(!cp || !p) return;
    cp.style.outlineColor = "red";
    const cpv = cp.value;
    const pv = p.value;

    if(!cpv || !pv) return;
    if(cpv !== pv) return cp.style.outlineColor = "red";
    cp.style.outlineColor = "green";
  });
</script>
</body>
</html>

  <section class="hero">
    <div class="container">
      <div>
        <div class="pill"><span class="badge badge-primary">New</span> <span>SAML SSO now generally available</span> <svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></div>
        <h1>Authentication for teams that <span class="grad">ship fast.</span></h1>
        <p class="lead">AuthKit is a complete user identity platform — sign-in, sign-up, MFA, SSO, and user management — that you can drop into any app in minutes.</p>
        <div class="cta-row">
          <a href="/register" class="btn btn-primary btn-lg">Start building free <svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
          <a href="/docs" class="btn btn-outline btn-lg"><svg class="" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/></svg> Read the docs</a>
        </div>
        <div class="trust">
          <span>Trusted by 12,000+ developer teams</span>
        </div>
      </div>
      <div class="hero-visual">
        <div class="code-card" style="border:0;">
          <div class="code-tabs">
            <button class="active">server.js</button>
            <button>login.tsx</button>
            <button>curl</button>
          </div>
          <pre><span class="cm">// Add authentication in three lines</span>
          <span class="kw">import</span> { authkit } <span class="kw">from</span> <span class="st">"@authkit/node"</span>;

          <span class="kw">const</span> auth = <span class="fn">authkit</span>({ apiKey: process.env.<span class="num">AUTHKIT_KEY</span> });

          app.<span class="fn">post</span>(<span class="st">"/login"</span>, <span class="kw">async</span> (req, res) =&gt; {
            <span class="kw">const</span> session = <span class="kw">await</span> auth.sessions.<span class="fn">create</span>({
              email: req.body.email,
              password: req.body.password,
            });
            res.<span class="fn">json</span>({ token: session.token });
          });</pre>
        </div>
      </div>
    </div>
  </section>


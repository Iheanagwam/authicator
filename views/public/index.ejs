  <section class="section" style="padding-top:0;">
    <div class="container">
      <div class="card card-lg">
        <div class="big-stats">
          <div><div class="n">1.2B+</div><div class="l">Authentications processed</div></div>
          <div><div class="n">99.99%</div><div class="l">Historical uptime</div></div>
          <div><div class="n">180+</div><div class="l">Countries served</div></div>
          <div><div class="n">SOC 2</div><div class="l">Type II certified</div></div>
        </div>
      </div>
